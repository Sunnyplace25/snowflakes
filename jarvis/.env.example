# ================================================================
# Snow flakes JARVIS - 環境変数テンプレート
# ================================================================
# このファイルをコピーして .env にリネームし、値を入力してください。
# .env は絶対にGitへコミットしないでください。
# ================================================================

# ── Anthropic API（第2段階以降で使用）──────────────────────────
# ANTHROPIC_API_KEY=

# ── X（Twitter）API（第4段階以降で使用）────────────────────────
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=
# X_BEARER_TOKEN=

# ── Instagram / Meta Graph API（第4段階以降で使用）─────────────
# META_APP_ID=
# META_APP_SECRET=
# META_ACCESS_TOKEN=
# INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ── GitHub（第2段階以降で使用）──────────────────────────────────
# GITHUB_TOKEN=

# ── JARVIS管理（必要に応じて設定）──────────────────────────────
# JARVIS_ADMIN_SECRET=
