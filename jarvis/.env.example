# ================================================================
# Snow flakes JARVIS - 環境変数テンプレート
# ================================================================
# このファイルをコピーして .env にリネームし、値を入力してください。
# .env は絶対にGitへコミットしないでください。
#
# 使用方法（CLI）:
#   node --env-file jarvis/.env jarvis/automation/sf_ops_runner.js
#
# Task Scheduler では install_sf_ops_task.ps1 が --env-file-if-exists で
# 自動的に読み込みます。
# ================================================================

# ── Anthropic API（オーケストレーター用）────────────────────────
# ANTHROPIC_API_KEY=

# ── Instagram / Meta Graph API（Phase 6 / Phase 10 AUTO sync）──
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_USER_ID=

# ── YouTube Analytics API（Phase 5/7 / Phase 10 AUTO sync）─────
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=
# YOUTUBE_CHANNEL_ID=

# ── X（Twitter）API（将来用）─────────────────────────────────────
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=
# X_BEARER_TOKEN=

# ── GitHub（将来用）──────────────────────────────────────────────
# GITHUB_TOKEN=

# ── JARVIS DB パス上書き（省略時は data/business_data.db）───────
# SF_DB_PATH=
