{
  "_comment": "Snow flakes JARVIS 設定ファイル。秘密情報・アクセストークンは絶対に書かないこと。",
  "_version": "0.4.0",

  "site": {
    "name": "Snow flakes",
    "url": "https://sunnyplace25.github.io/snowflakes/",
    "author": "山吹ことり",
    "repository": "https://github.com/Sunnyplace25/snowflakes.git",
    "branch": {
      "main": "main",
      "work": "jarvis-development"
    }
  },

  "git": {
    "auto_commit": false,
    "auto_push": false,
    "individual_add_only": true,
    "_note": "git add は対象ファイルを個別指定すること。git add . は使用禁止。"
  },

  "sns": {
    "x": {
      "enabled": false,
      "auto_post": false,
      "account": "@snflk_official",
      "_note": "enabledがfalseの間はAPI接続・投稿処理をすべて行わない"
    },
    "instagram": {
      "enabled": false,
      "auto_post": false,
      "account": "snowflakes_official",
      "_note": "Instagram Graph APIはFacebookページとの接続確認後に設定する"
    }
  },

  "api": {
    "anthropic": {
      "enabled": false,
      "_note": "第1段階では未使用。基本動作確認後に別途承認を得て有効化する。"
    }
  },

  "budget": {
    "currency": "JPY",
    "monthly_limit": 0,
    "warn_threshold_percent": 80,
    "auto_stop_at_limit": true,
    "_note": "monthly_limitが0の場合は上限なし（初期設定）。SNS API料金は変動するため、使用前に必ず確認する。"
  },

  "safety": {
    "require_approval_for_site_publish": true,
    "require_approval_for_sns_post": true,
    "require_approval_for_git_push": true,
    "show_cost_estimate_before_post": true,
    "prevent_duplicate_post": true
  },

  "exclude_from_processing": [
    "music/kaeranai_streaming.mp3",
    "music/kaeranai_streaming.wav",
    "sweets/sf2026ncr_a7f3e.mp3",
    "sweets/sf2026ncr_b2d91.mp3",
    "sweets/sf2026ncr_c4a0f.mp3",
    "sweets/sf2026ncr_d8e52.mp3",
    "sweets/sf2026ncr_e1c7b.mp3",
    "sweets/sf2026ncr_f6094.mp3",
    "sweets/sf2026ncr_g3d28.mp3",
    "sweets/sf2026ncr_h9b4e.mp3"
  ],

  "draft": {
    "types": ["site_update", "sns_x", "sns_instagram", "youtube_video", "tiktok_video", "news", "activity_report"],
    "pending_dir": "drafts/pending",
    "approved_dir": "drafts/approved",
    "published_dir": "drafts/published"
  },

  "instagram": {
    "bio_link_note": "プロフィールのリンクからご確認いただけます。",
    "bio_link_note_en": "Check the link in bio for details."
  },

  "platform_limits": {
    "x_warning_length": 280,
    "instagram_warning_length": 2200,
    "x_hashtag_recommended_max": 3
  },

  "scheduling": {
    "timezone": "Asia/Tokyo",
    "allow_past_schedule": false,
    "minimum_lead_minutes": 10,
    "duplicate_window_minutes": 5,
    "external_posting_enabled": false,
    "dry_run_only": true
  },

  "platform_posting": {
    "x": {
      "enabled": false,
      "provider": null
    },
    "instagram": {
      "enabled": false,
      "provider": null
    },
    "youtube": {
      "enabled": false,
      "provider": null
    },
    "tiktok": {
      "enabled": false,
      "provider": null
    }
  },

  "youtube": {
    "default_privacy_status": "private",
    "default_publish_mode": "scheduled",
    "require_made_for_kids_setting": true,
    "_api_note": "第4段階後半では、YouTube Data API v3 のインストール済みアプリ向け OAuth 2.0 認証を採用する。具体的な認証方式は、実装時点の Google 公式仕様を確認して決定する。",
    "_publish_at_note": "将来API接続時: content.scheduled_at → status.publishAt、同時に status.privacyStatus = 'private' を設定する。公開済み動画は予約公開の対象にしない。"
  },

  "tiktok": {
    "default_post_mode": "media_upload",
    "direct_post_enabled": false,
    "require_aigc_setting": true,
    "require_privacy_confirmation": true,
    "caption_warning_length": 2200,
    "_api_note": "初期接続は MEDIA_UPLOAD を優先する。DIRECT_POST はアプリ審査と公開権限の確認後に別途実装する。TikTok Content Posting API の OAuth 2.0 認証方式は、実装時点の TikTok 公式仕様を確認して決定する。"
  }
}
