.vercel
hayatecchi/rhythm/*.mp4

# ─── 音声ファイル（配信・収録マスター／サブフォルダ含む）───────────────
music/*.mp3
music/*.wav
music/**/*.mp3
music/**/*.wav
sweets/*.mp3
sweets/*.wav
sweets/**/*.mp3
sweets/**/*.wav

# ─── JARVIS ───────────────────────────
jarvis/.env
jarvis/logs/*.log
jarvis/drafts/pending/*
!jarvis/drafts/pending/.gitkeep
# ─── JARVIS secrets ───────────────────
jarvis/secrets/*
!jarvis/secrets/.gitkeep
jarvis/ga4-service-account.json
jarvis/*-service-account.json
# ──────────────────────────────────────
jarvis/node_modules/
# JARVIS AI Bridge — 実行時状態（セッション・レビュー・ログ）
jarvis/ai/runtime/*
!jarvis/ai/runtime/.gitignore
# JARVIS orchestrator task state
jarvis/tasks/*
!jarvis/tasks/.gitkeep
# JARVIS 共通データ基盤 — 実データDB（個人データはgit管理しない）
jarvis/data/*.db
jarvis/data/*.db-wal
jarvis/data/*.db-shm
jarvis/data/*.db.bak_*
# JARVIS DB バックアップ（backups/ 配下の .db ファイル）
jarvis/backups/*.db
# schema.sql / *.js は Git 管理対象（除外しない）
# JARVIS Soundrop インポート元CSVs（個人収益データ）
jarvis/imports/soundrop/*.csv
# JARVIS 請求書 Excel（個人・取引先情報を含むためgit管理しない）
jarvis/imports/invoices/*.xlsx
jarvis/imports/invoices/*.xls
jarvis/imports/*.xlsx
jarvis/imports/*.xls
# JARVIS 生成請求書（個人・取引先情報を含むためgit管理しない）
jarvis/exports/invoices/*
!jarvis/exports/invoices/.gitkeep
# JARVIS Network キャプチャ（認証情報を含む可能性）
jarvis/imports/*.har
jarvis/imports/*.har.*
jarvis/imports/*_audit.txt
# JARVIS note export — 投稿用コンテンツ（公開前コンテンツはgit管理しない）
jarvis/exports/note/*
!jarvis/exports/note/.gitkeep
