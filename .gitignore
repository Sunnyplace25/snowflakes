.vercel
hayatecchi/rhythm/*.mp4

# ─── JARVIS ───────────────────────────
jarvis/.env
jarvis/logs/*.log
jarvis/drafts/pending/*
!jarvis/drafts/pending/.gitkeep
# ─── JARVIS secrets ───────────────────
jarvis/secrets/*
!jarvis/secrets/.gitkeep
# ──────────────────────────────────────
jarvis/node_modules/
# JARVIS AI Bridge — 実行時状態（セッション・レビュー・ログ）
jarvis/ai/runtime/*
!jarvis/ai/runtime/.gitignore
# JARVIS orchestrator task state
jarvis/tasks/*
!jarvis/tasks/.gitkeep
# JARVIS 共通データ基盤 — 実データDB（個人データはgit管理しない）
jarvis/data/*.db
# schema.sql / *.js は Git 管理対象（除外しない）
# JARVIS note export — 投稿用コンテンツ（公開前コンテンツはgit管理しない）
jarvis/exports/note/*
!jarvis/exports/note/.gitkeep
